import numpy as np
import matplotlib.pyplot as plt
from astropy.visualization import (ZScaleInterval, LogStretch, ImageNormalize)

# Assuming x_data and ir_data are already in your memory from the last run
def process_forensic_layer(data, title, cmap):
    # 1. CLEANING: Remove NaNs and infinities
    clean_data = np.nan_to_num(data)
    
    # 2. BACKGROUND SUBTRACTION: 
    # We subtract the median to isolate 'excess heat' from the noise floor
    bkg_level = np.median(clean_data)
    data_sub = clean_data - bkg_level
    
    # 3. CONTRAST STRETCH: 
    # Use 'ZScale' to focus on the faint variations, not the bright stars
    interval = ZScaleInterval()
    norm = ImageNormalize(data_sub, interval=interval, stretch=LogStretch())
    
    return data_sub, norm

