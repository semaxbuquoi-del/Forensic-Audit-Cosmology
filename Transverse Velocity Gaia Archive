from astroquery.gaia import Gaia
import astropy.units as u

ra, dec, radius = 205.2561, 30.00, 1.0

# Using a 10,000 row limit to stay within Colab/Gaia memory limits
query = f"""
SELECT TOP 10000
    source_id, ra, dec, pmra, pmdec, parallax, 
    phot_g_mean_mag, astrometric_excess_noise
FROM gaiadr3.gaia_source
WHERE 1=CONTAINS(
    POINT('ICRS', ra, dec),
    CIRCLE('ICRS', {ra}, {dec}, {radius})
)
AND parallax < 0.3  -- Isolates distant objects
AND phot_g_mean_mag > 18.0  -- Targets the dimmer, more numerous galaxies
AND astrometric_excess_noise > 0.05 -- Captures the "Metric Jitter"
ORDER BY phot_g_mean_mag ASC
"""

print(f"Launching Massive Audit of Boötes North (1.0 degree radius)...")
job = Gaia.launch_job_async(query)
results = job.get_results()
df_wide = results.to_pandas()
print(f"Success! Captured {len(df_wide)} potential metric markers.")
