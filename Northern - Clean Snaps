import pandas as pd
import numpy as np
from astroquery.sdss import SDSS
import matplotlib.pyplot as plt

# 1. DEFINE WIDE-AREA BOOTES PARAMETERS (Control Group)
void_name = "Boötes_Wide_Audit"
# Expanding RA/Dec to match the Ursa Major "Much Larger Dataset" scale
ra_min, ra_max = 200.0, 230.0  
dec_min, dec_max = 35.0, 50.0   

# 2. THE UNIFIED SQL QUERY (Identical to Ursa Major)
query = f"""
SELECT
    p.objid, s.specobjid, p.ra, p.dec, 
    p.modelMag_r as r_mag, 
    s.z as redshift, 
    s.zErr as z_err,
    s.zWarning as warning_flag,
    s.snMedian as snr,
    p.nChild as children
FROM PhotoObj AS p
JOIN SpecObj AS s ON s.bestobjid = p.objid
WHERE
    p.ra BETWEEN {ra_min} AND {ra_max}
    AND p.dec BETWEEN {dec_min} AND {dec_max}
    AND s.class = 'GALAXY'
"""

try:
    results = SDSS.query_sql(query)
    df = results.to_pandas()
    print(f"--- {void_name} Raw Data ---")
    print(f"Total Population: {len(df)}")
except Exception as e:
    print(f"Error: {e}")

# 3. IDENTIFYING CLEAN METRIC SNAPS (The Forensic Indicator)
bright_nulls = df[(df['r_mag'] < 18) & (df['warning_flag'] > 0)].copy()
# Criteria for 'Clean' Snaps: High SNR (Signal exists) and Isolated (No interference)
impossible_failures = bright_nulls[bright_nulls['snr'] > 15]
clean_snaps = impossible_failures[impossible_failures['children'] == 0]

print(f"Found {len(bright_nulls)} total Bright Nulls.")
print(f"Found {len(clean_snaps)} 'Clean' Metric Snaps.")

# 4. STANDARDIZED COORDINATE DEPTH MAP
c = 299792.458
df['velocity'] = df['redshift'] * c

plt.figure(figsize=(12, 7))
plt.scatter(df['ra'], df['velocity'], c='blue', s=1, alpha=0.3, label='Laminar Population')
plt.scatter(bright_nulls['ra'], [0]*len(bright_nulls), c='red', s=15, marker='x', label='Metric Snaps')
plt.scatter(clean_snaps['ra'], [0]*len(clean_snaps), edgecolors='yellow', facecolors='none', s=50, label='Clean Snaps (Control)')

plt.title(f"Forensic Audit: {void_name} - Standardized Coordinate Depth", fontsize=14)
plt.xlabel("Right Ascension (RA)")
plt.ylabel("Velocity (km/s)")
plt.ylim(-5000, 150000) # Standardized Y-axis for side-by-side comparison
plt.legend()
plt.show()
