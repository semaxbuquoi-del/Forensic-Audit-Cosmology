import pandas as pd
import numpy as np
from astroquery.vizier import Vizier
from astropy.coordinates import SkyCoord
import astropy.units as u

def forensic_retrieval(void_name, ra_min, ra_max, dec_min, dec_max):
    print(f"--- Initiating Forensic Audit: {void_name} ---")
    c = 299792.458
    ra_mid, dec_mid = (ra_min + ra_max) / 2, (dec_min + dec_max) / 2
    width, height = (ra_max - ra_min), (dec_max - dec_min)
    
    # 1. NORTHERN AUDIT: DESI DR1 (VizieR V/161)
    # Applied if Dec > -30 (DESI's coverage zone)
    if dec_max > -30:
        print(f"[{void_name}] Querying DESI DR1 Database...")
        v = Vizier(columns=['RAICRS', 'DEICRS', 'z', 'ZWARN', 'Fr', 'OType'], row_limit=-1)
        res = v.query_region(SkyCoord(ra=ra_mid, dec=dec_mid, unit=(u.deg, u.deg)),
                             width=width*u.deg, height=height*u.deg, catalog="V/161/zcatalog")
        df = res[0].to_pandas()
        df.rename(columns={'RAICRS': 'ra', 'DEICRS': 'dec', 'Fr': 'flux_r', 'ZWARN': 'zwarning'}, inplace=True)
        df['r'] = 22.5 - 2.5 * np.log10(df['flux_r'].clip(lower=1e-5)) # Nanomaggies to Mag
        df['v_kms'] = df['z'] * c
        df['survey'] = 'DESI'

    # 2. SOUTHERN AUDIT: 6dFGS (VizieR VII/249)
    # Applied if Dec < 0
    elif dec_min < 0:
        print(f"[{void_name}] Querying 6dFGS Southern Database...")
        v = Vizier(columns=['RAJ2000', 'DEJ2000', 'z', 'q_z', 'r_mag'], row_limit=-1)
        res = v.query_region(SkyCoord(ra=ra_mid, dec=dec_mid, unit=(u.deg, u.deg)),
                             width=width*u.deg, height=height*u.deg, catalog="VII/249/6dfgs")
        df = res[0].to_pandas()
        df.rename(columns={'RAJ2000': 'ra', 'DEJ2000': 'dec', 'r_mag': 'r', 'q_z': 'zwarning'}, inplace=True)
        df['v_kms'] = df['z'] * c
        df['survey'] = '6dFGS'

    # 3. FORENSIC FILTERING (The Metric Logic)
    # Population: Filter for high-quality GALAXY spectra
    pop = df[((df['survey'] == 'DESI') & (df['OType'] == 'GALAXY') & (df['zwarning'] == 0)) |
             ((df['survey'] == '6dFGS') & (df['zwarning'] >= 3))].copy()
    
    # Bright Nulls: r < 18 but metric failure flags (ZWARN != 0 or q_z < 3)
    nulls = df[(df['r'] < 18) & (
        ((df['survey'] == 'DESI') & (df['zwarning'] != 0)) |
        ((df['survey'] == '6dFGS') & (df['zwarning'] < 3))
    )].copy()

    # 4. EXPORT
    pop.to_csv(f'{void_name}_raw_population.csv', index=False)
    nulls.to_csv(f'{void_name}_bright_nulls.csv', index=False)
    print(f"Audit Complete. Saved: {len(pop)} targets and {len(nulls)} Nulls.")
    return pop, nulls

# --- RUN BOOTES AUDIT (DESI) ---
pop, nulls = forensic_retrieval("Bootes_Void", 211.0, 226.0, 38.0, 50.0)
