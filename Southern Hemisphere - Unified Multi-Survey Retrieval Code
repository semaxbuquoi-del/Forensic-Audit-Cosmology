print(f"Initiating Southern Audit: {v_name}...")

# 2. DYNAMIC DISCOVERY & DATA PULL
# We use row_limit=-1 to ensure we get the full reservoir population
v = Vizier(columns=['*'], row_limit=-1)
coords = SkyCoord(ra=target_ra, dec=target_dec, unit=(u.deg, u.deg))
res = v.query_region(coords, radius=15*u.deg, catalog="VII/249/master")

if res:
    table = res[0]
    cols = table.colnames
    print(f"Detected 6dFGS Columns: {cols}")

    # Map database names to our forensic variables
    ra_col = next(c for c in cols if c.lower() in ['raj2000', 'ra', 'raj'])
    dec_col = next(c for c in cols if c.lower() in ['dej2000', 'dec', 'dej'])
    v_col = next(c for c in cols if c.lower() in ['cz', 'v_kms', 'vel', 'z'])
    r_col = next(c for c in cols if 'rmag' in c.lower() or 'rfmag' in c.lower() or 'r_mag' in c.lower())

    # 3. COORDINATE NORMALIZATION (The RA Fix)
    # Check if RA is in Decimal Degrees or Hour Angle
    sample_ra = table[ra_col][0]
    
    # If the database provides a string with ':' or is small (<24), we treat as Hour Angle
    if isinstance(sample_ra, str) and ':' in sample_ra:
        c_list = SkyCoord(ra=table[ra_col], dec=table[dec_col], unit=(u.hourangle, u.deg))
    elif np.max(table[ra_col]) <= 24.1:
        c_list = SkyCoord(ra=table[ra_col], dec=table[dec_col], unit=(u.hourangle, u.deg))
    else:
        c_list = SkyCoord(ra=table[ra_col], dec=table[dec_col], unit=(u.deg, u.deg))
    
    # 4. DATA EXTRACTION & CLEANING
    v_list = np.ma.filled(table[v_col], 0.0) # Fills masked values with 0 (The Snaps)
    r_list = np.ma.filled(table[r_col], 20.0)

    df = pd.DataFrame({
        'ra': c_list.ra.deg,
        'dec': c_list.dec.deg,
        'v': v_list,
        'r': r_list
    })
    
