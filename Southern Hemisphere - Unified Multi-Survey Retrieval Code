# 1. Setup Environment
!pip install -q astroquery
import pandas as pd
import numpy as np
from astroquery.vizier import Vizier
from astropy.coordinates import SkyCoord
import astropy.units as u

# --- CONFIGURATION ---
v_name = "Eridanus_Supervoid"
r_lim = 15.6

print("Initiating Dynamic Discovery of Southern Columns...")
v = Vizier(columns=['*'], row_limit=-1)
coords = SkyCoord(ra=47.5, dec=-25.0, unit=(u.deg, u.deg))
res = v.query_region(coords, radius=15*u.deg, catalog="VII/249/master")

if res:
    table = res[0]
    cols = table.colnames
    print(f"Detected columns: {cols}")

    # 2. DYNAMIC COLUMN FINDER
    # We find which name the mirror is using for the key siphonic metrics
    ra_col = next(c for c in cols if c.lower() in ['raj2000', 'ra'])
    dec_col = next(c for c in cols if c.lower() in ['dej2000', 'dec'])
    v_col = next(c for c in cols if c.lower() in ['cz', 'v_kms', 'vel'])
    r_col = next(c for c in cols if 'rmag' in c.lower() or 'rfmag' in c.lower() or c.lower() == 'r_mag')

    # 3. CONVERSION LOGIC
    # Convert Sexagesimal strings to Decimal Degrees
    ra_raw = [str(x) for x in table[ra_col]]
    dec_raw = [str(x) for x in table[dec_col]]
    c_list = SkyCoord(ra=ra_raw, dec=dec_raw, unit=(u.hourangle, u.deg))
    
    # Extract numeric data, handling masked values/NaNs
    v_list = [float(x) if np.ma.is_masked(x) == False and x is not None else 0.0 for x in table[v_col]]
    r_list = [float(x) if np.ma.is_masked(x) == False and x is not None else 20.0 for x in table[r_col]]
    
    # 4. CONSTRUCT DATAFRAME
    df = pd.DataFrame({
        'ra': c_list.ra.deg,
        'dec': c_list.dec.deg,
        'v': v_list,
        'r': r_list
    })
    
    # 5. DEDUPLICATE & ANALYZE
    df = df.drop_duplicates(subset=['ra', 'dec']).reset_index(drop=True)
    pop = df[df['v'] > 0].copy()
    nulls = df[(df['r'] < r_lim) & (df['v'] <= 0)].copy()
    
    # Jitter Calculation (Dispersion per 0.5 deg bin)
    pop['ra_b'] = (pop['ra'] // 0.5) * 0.5
    pop['dec_b'] = (pop['dec'] // 0.5) * 0.5
    j_map = pop.groupby(['ra_b', 'dec_b'])['v'].agg(['std', 'count']).reset_index()

    # 6. EXPORT
    pop.to_csv(v_name + '_population.csv', index=False)
    nulls.to_csv(v_name + '_nulls.csv', index=False)
    
    print("\n" + "="*35)
    print("SUCCESS: SOUTHERN DATA SECURED")
    print(f"Unique Galaxies: {len(pop)}")
    print(f"Metric Snaps (Nulls): {len(nulls)}")
    if not j_map.empty:
        print(f"Max Jitter: {round(j_map['std'].max(), 2)} km/s")
    print("="*35)
else:
    print("Query failed. Server might be timing out.")
