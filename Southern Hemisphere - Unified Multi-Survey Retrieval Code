# 1. Setup Environment
!pip install -q astroquery
import pandas as pd
import numpy as np
from astroquery.vizier import Vizier
from astropy.coordinates import SkyCoord
import astropy.units as u

# --- CONFIGURATION (6dFGS - ERIDANUS SUPERVOID) ---
void_name = "Eridanus_Supervoid"
ra_range = [30.0, 65.0]     
dec_range = [-40.0, -10.0]
c = 299792.458              
m_p = 938.272e6             
r_limit = 15.6              

# 2. Forensic Retrieval from 6dFGS (VizieR VII/249)
print("Retrieving Southern Metric Baseline...")
v = Vizier(columns=['RAJ2000', 'DEJ2000', 'z', 'q_z', 'r_mag'], row_limit=-1)

ra_mid = (ra_range[0] + ra_range[1]) / 2
dec_mid = (dec_range[0] + dec_range[1]) / 2

res = v.query_region(
    SkyCoord(ra=ra_mid, dec=dec_mid, unit=(u.deg, u.deg)),
    width=(ra_range[1]-ra_range[0])*u.deg,
    height=(dec_range[1]-dec_range[0])*u.deg,
    catalog="VII/249/6dfgs"
)

if res is not None and len(res) > 0:
    df = res[0].to_pandas()
    df.rename(columns={'RAJ2000': 'ra', 'DEJ2000': 'dec', 'r_mag': 'r', 'q_z': 'quality'}, inplace=True)
    df['v_kms'] = df['z'] * c

    # 3. Establish the Kinematic Baseline
    pop = df[df['quality'] >= 3].copy()
    
    # 4. Identify Bright Nulls (r < 15.6, Quality < 3)
    bright_nulls = df[(df['r'] < r_limit) & (df['quality'] < 3)].copy()

    # 5. Jitter Analysis
    pop['ra_bin'] = (pop['ra'] // 0.5) * 0.5
    pop['dec_bin'] = (pop['dec'] // 0.5) * 0.5
    
    jitter_map = pop.groupby(['ra_bin', 'dec_bin'])['v_kms'].agg(['std', 'count']).reset_index()
    jitter_map.columns = ['ra', 'dec', 'jitter_kms', 'count']
    jitter_map = jitter_map[jitter_map['count'] >= 2]

    # 6. Thermodynamic Calculation
    if not jitter_map.empty:
        peak_jitter = jitter_map['jitter_kms'].max()
        ek_kev = (0.5 * m_p * (peak_jitter / c)**2) / 1000
    else:
        peak_jitter, ek_kev = 0, 0

    # 7. Export Datasets
    pop.to_csv(void_name + '_raw_population.csv', index=False)
    jitter_map.to_csv(void_name + '_jitter_analysis.csv', index=False)
    bright_nulls.to_csv(void_name + '_bright_nulls.csv', index=False)

    # 8. Forensic Summary
    print("\n" + "="*40)
    print("6dFGS AUDIT SUMMARY: Eridanus")
    print("Total Population (Q>=3):", len(pop))
    print("Bright Nulls (r < 15.6, Q<3):", len(bright_nulls))
    print("Peak Metric Jitter (km/s):", round(peak_jitter, 2))
    print("Energy Potential (keV):", round(ek_kev, 2))
    print("="*40)
else:
    print("Error: No data returned from 6dFGS.")
