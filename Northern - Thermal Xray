from astroquery.skyview import SkyView
import matplotlib.pyplot as plt
import numpy as np
from astropy import units as u

# 1. TARGET: BOÖTES NOZZLE CORE
target_coords = "220.0 37.0"
search_radius = 2.0 * u.deg 

# 2. DEFINITIVE FALLBACK LIST (The 2026 'Most Likely' Strings)
# We check these in order. Once one works, we move to IR.
xray_names = ['RASS Broad', 'RASS-cnt Broad', 'ROSAT PSPC Broad', 'Fermi 5']
ir_names = ['WISE 12 micron', 'WISE 12', 'Planck 857']

def fetch_data(name_list):
    for name in name_list:
        try:
            print(f"Testing {name}...")
            img = SkyView.get_images(position=target_coords, survey=[name], radius=search_radius)
            if img:
                return name, img[0][0].data
        except:
            continue
    return None, None

print(f"Initiating Archival Audit for Nozzle Centroid: {target_coords}...")

# Execute Audit
x_name, x_data = fetch_data(xray_names)
ir_name, ir_data = fetch_data(ir_names)

# 3. VISUALIZATION
if x_data is not None:
    fig, ax = plt.subplots(1, 2 if ir_data is not None else 1, figsize=(15, 7))
    if ir_data is None: ax = [ax]

    # Plot X-Ray/High-Energy (The Metric Heat Signature)
    # Using log scaling to pull out the faint 'Phase Transition' glow
    x_plot = np.log10(np.nan_to_num(x_data) - np.nanmin(x_data) + 1)
    im1 = ax[0].imshow(x_plot, cmap='inferno', origin='lower')
    ax[0].set_title(f"Thermal State: {x_name}", fontsize=12)
    plt.colorbar(im1, ax=ax[0], label='Log Flux (38.5 MeV Bridge)')

    if ir_data is not None:
        # Plot Infrared (The Siphonic Dust Intake)
        ir_plot = np.log10(np.nan_to_num(ir_data) - np.nanmin(ir_data) + 1)
        im2 = ax[1].imshow(ir_plot, cmap='magma', origin='lower')
        ax[1].set_title(f"Siphonic Draft: {ir_name}", fontsize=12)
        plt.colorbar(im2, ax=ax[1], label='Dust Friction Map')

    plt.suptitle(f"Forensic Audit: {target_coords} | Multi-Messenger Verification", fontsize=16)
    plt.tight_layout()
    plt.show()
else:
    print("Forensic Failure: All archival survey names rejected by SkyView. Manual catalog check required.")
