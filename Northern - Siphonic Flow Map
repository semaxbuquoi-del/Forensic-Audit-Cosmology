import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# 1. Load the Forensic Data
df = pd.read_csv('Bootes_Void_raw_population.csv')

# 2. Define the Mechanical Reference Points
# Based on the Boötes Audit coordinates
core = np.array([222.5, 46.0])     # The Reservoir Center
nozzle = np.array([223.0, 41.5])   # The Siphonic Breach

# 3. Calculate the Siphonic Vector
siphonic_vector = nozzle - core
vector_length = np.linalg.norm(siphonic_vector)
unit_vector = siphonic_vector / vector_length

# 4. Project Galaxies onto the Siphonic Axis
def project_onto_axis(ra, dec):
    point = np.array([ra, dec])
    relative_point = point - core
    # Dot product gives the distance along the core-nozzle vector
    projection = np.dot(relative_point, unit_vector)
    return projection

df['axis_pos'] = df.apply(lambda row: project_onto_axis(row['ra'], row['dec']), axis=1)

# 5. Bin Data along the Axis (0.5 degree segments)
bins = np.linspace(-2, 7, 25)
df['bin'] = pd.cut(df['axis_pos'], bins)

# 6. Calculate Flow Parameters (Density, Velocity, Jitter)
flow_analysis = df.groupby('bin').agg({
    'v_kms': ['mean', 'std', 'count'],
    'axis_pos': 'mean'
}).reset_index()

flow_analysis.columns = ['bin', 'v_mean', 'jitter', 'density', 'pos_mean']
flow_analysis = flow_analysis.dropna()

# 7. Calculate the Flow Gradients
# Density Gradient = Change in density / Change in distance
flow_analysis['density_gradient'] = flow_analysis['density'].diff() / flow_analysis['pos_mean'].diff()

# 8. Plot the Siphonic Flow Map
fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(11, 9), sharex=True)

# Top Panel: Density & Mean Velocity
ax1.plot(flow_analysis['pos_mean'], flow_analysis['density'], 'b-o', label='Galaxy Density')
ax1.set_ylabel('Galaxy Count', color='b')
ax1.set_title('Boötes Void: Siphonic Flow Analysis (Core → Nozzle)')

ax1b = ax1.twinx()
ax1b.plot(flow_analysis['pos_mean'], flow_analysis['v_mean'], 'r-s', label='Mean Velocity')
ax1b.set_ylabel('Mean Velocity (km/s)', color='r')

# Vertical Reference Lines
ax1.axvline(0, color='magenta', linestyle='--', label='Void Core')
ax1.axvline(vector_length, color='lime', linestyle='--', label='Nozzle Breach')

# Bottom Panel: Metric Jitter & Density Gradient
ax2.plot(flow_analysis['pos_mean'], flow_analysis['jitter'], 'k-^', label='Metric Jitter')
ax2.set_ylabel('Jitter (km/s)')
ax2.set_xlabel('Degrees along Siphonic Axis (Core = 0)')

ax2b = ax2.twinx()
ax2b.plot(flow_analysis['pos_mean'], flow_analysis['density_gradient'], 'g--', label='Flow Rate (Gals/Deg)')
ax2b.set_ylabel('Density Gradient', color='g')

ax1.legend(loc='upper left', fontsize='small')
ax2.legend(loc='upper left', fontsize='small')

plt.tight_layout()
plt.savefig('bootes_flow_rate_map.png')
plt.show()

print(f"Flow Analysis Complete. Axis Distance: {vector_length:.2f} degrees.")
