import numpy as np
import matplotlib.pyplot as plt

# 1. DEFINE MECHANICAL ANCHORS (Updated to your 220/37 Discovery)
# Core: Center of your search window | Nozzle: Where the snaps are clustering
core = np.array([df['ra'].median(), df['dec'].median()]) 
nozzle = np.array([220.0, 37.0]) 

# 2. CALCULATE THE SIPHONIC VECTOR
siphonic_vector = nozzle - core
vector_length = np.linalg.norm(siphonic_vector)
unit_vector = siphonic_vector / vector_length

# 3. PROJECT GALAXY POPULATION ONTO THE AXIS
def project_onto_axis(ra, dec):
    point = np.array([ra, dec])
    relative_point = point - core
    return np.dot(relative_point, unit_vector)

df['axis_pos'] = df.apply(lambda row: project_onto_axis(row['ra'], row['dec']), axis=1)

# 4. BIN DATA ALONG THE AXIS
# We look from before the core to past the nozzle
bins = np.linspace(-5, vector_length + 5, 30)
df['bin_center'] = df['axis_pos'].apply(lambda x: bins[np.digitize(x, bins)-1] if 0 < np.digitize(x, bins) < len(bins) else np.nan)

# 5. FLOW ANALYSIS (Density, Velocity, Jitter)
flow_analysis = df.groupby('bin_center').agg({
    'velocity': ['mean', 'std', 'count']
}).reset_index()

flow_analysis.columns = ['pos', 'v_mean', 'jitter', 'density']
flow_analysis = flow_analysis.dropna()

# Calculate Flow Rate (Density Gradient)
flow_analysis['flow_rate'] = flow_analysis['density'].diff() / flow_analysis['pos'].diff()

# 6. PLOT THE FLOW MAP
