import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from astroquery.sdss import SDSS

# 1. BOÖTES VOID BOUNDARIES
void_name = "Boötes_Full_Population_Audit"
ra_min, ra_max = 210.0, 235.0  
dec_min, dec_max = 30.0, 45.0   

# 2. SQL QUERY: BROAD POPULATION PULL
# We pull everything, including warnings, to measure the "health" of the metric
query = f"""
SELECT
    p.ra, p.dec, p.modelMag_r as r_mag, 
    s.z as redshift, s.zErr as z_err,
    s.zWarning as warning_flag, s.snMedian as snr
FROM PhotoObj AS p
JOIN SpecObj AS s ON s.bestobjid = p.objid
WHERE
    p.ra BETWEEN {ra_min} AND {ra_max}
    AND p.dec BETWEEN {dec_min} AND {dec_max}
    AND s.class = 'GALAXY'
"""

print(f"Auditing Full Population for {void_name}...")
results = SDSS.query_sql(query)
df = results.to_pandas()

# Standardize velocity
c = 299792.458
df['velocity'] = df['redshift'] * c

# 3. DEFINE THE SIPHONIC AXIS (The Path to the Nozzle)
# Origin: Void Center | Destination: Predicted Nozzle
core = np.array([218.0, 40.0]) 
nozzle = np.array([220.0, 37.0]) 

vector = nozzle - core
vector_len = np.linalg.norm(vector)
unit_vector = vector / vector_len

# Project every galaxy onto the "tension axis"
def get_projection(ra, dec):
    point = np.array([ra, dec])
    rel = point - core
    return np.dot(rel, unit_vector)

df['dist_to_nozzle'] = df.apply(lambda x: get_projection(x['ra'], x['dec']), axis=1)

# 4. MEASURE METRIC JITTER (Rolling Statistics)
# We sort by proximity to nozzle and calculate the "shaking" of the population
df = df.sort_values('dist_to_nozzle')
df['rolling_jitter'] = df['velocity'].rolling(window=50).std()
df['rolling_density'] = df['velocity'].rolling(window=50).count()

# 5. VISUALIZING THE KINEMATIC HUMP
fig, ax1 = plt.subplots(figsize=(14, 8))

# Background: All Galaxies
ax1.scatter(df['dist_to_nozzle'], df['velocity'], c='blue', alpha=0.1, s=2, label='Galaxy Population')
ax1.set_xlabel('Degrees Along Siphonic Axis (Negative = Core, Positive = Past Nozzle)', fontsize=12)
ax1.set_ylabel('Velocity (km/s)', color='blue')

# Primary Evidence: The Jitter Curve (Metric Tension)
ax2 = ax1.twinx()
ax2.plot(df['dist_to_nozzle'], df['rolling_jitter'], color='red', linewidth=2, label='Metric Jitter (Vacuum Tension)')
ax2.set_ylabel('Velocity Jitter (Standard Deviation km/s)', color='red', fontsize=12)

# Marker for the Predicted Snap Point
plt.axvline(x=vector_len, color='lime', linestyle='--', alpha=0.8, label='Predicted Nozzle (220/37)')

plt.title(f"Population Audit: {void_name}\nEvidence of Metric Jitter Elevation near Predicted Nozzle", fontsize=15)
ax1.grid(alpha=0.3)
plt.show()

# 6. CALCULATE THE "SIGNIFICANCE RATIO"
baseline_jitter = df[df['dist_to_nozzle'] < 0]['rolling_jitter'].mean()
peak_jitter = df['rolling_jitter'].max()
surge_ratio = (peak_jitter / baseline_jitter - 1) * 100

print(f"--- FINAL AUDIT RESULTS ---")
print(f"Baseline Void Jitter: {baseline_jitter:.2f} km/s")
print(f"Peak Nozzle Jitter: {peak_jitter:.2f} km/s")
print(f"Kinematic Surge: {surge_ratio:.2f}%")

# --- FORENSIC DATA VALIDATION ---
# This creates a table to check if the 61% surge is statistically significant
df['bin'] = pd.cut(df['dist_to_nozzle'], bins=15)
forensic_table = df.groupby('bin').agg({
    'velocity': ['count', 'mean', 'std'],
    'warning_flag': 'sum'
}).reset_index()

forensic_table.columns = ['Proximity_Bin', 'Galaxy_Count', 'Mean_V', 'Jitter_Std', 'Total_Warnings']

print("\n--- COMMITTEE VALIDATION TABLE ---")
print(forensic_table)

# Check for the "Needle" vs "Hump"
peak_bin = forensic_table.loc[forensic_table['Jitter_Std'].idxmax()]
print(f"\nPEAK ANALYSIS:")
print(f"The 61% surge is driven by {peak_bin['Galaxy_Count']} galaxies.")
print(f"Total Warning Flags in peak bin: {peak_bin['Total_Warnings']}")
