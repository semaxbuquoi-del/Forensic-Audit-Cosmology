import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from astroquery.sdss import SDSS

# 1. DEFINE THE BLIND SEARCH AREA (Broad Boötes Region)
void_name = "Boötes_Blind_Discovery_Audit"
ra_min, ra_max = 205.0, 235.0  # Wide sweep
dec_min, dec_max = 30.0, 50.0   

# 2. SQL QUERY: FULL POPULATION GATHERING
query = f"""
SELECT
    p.ra, p.dec,
    s.z as redshift, s.zWarning as warning_flag
FROM PhotoObj AS p
JOIN SpecObj AS s ON s.bestobjid = p.objid
WHERE
    p.ra BETWEEN {ra_min} AND {ra_max}
    AND p.dec BETWEEN {dec_min} AND {dec_max}
    AND s.class = 'GALAXY'
"""

print(f"Executing Blind Sweep for {void_name}...")
results = SDSS.query_sql(query)
df = results.to_pandas()
c = 299792.458
df['velocity'] = df['redshift'] * c

# 3. SCANNING FOR THE METRIC DISCONTINUITY
# We sweep by RA and use the window of 100 you validated earlier
df = df.sort_values('ra')
df['rolling_jitter'] = df['velocity'].rolling(window=100).std()

# DYNAMIC DETECTION: Where is the peak of the mountain?
peak_idx = df['rolling_jitter'].idxmax()
blind_ra = df.loc[peak_idx, 'ra']
peak_val = df['rolling_jitter'].max()
baseline_val = df['rolling_jitter'].median()
blind_surge = (peak_val / baseline_val - 1) * 100

# 4. VISUALIZING THE UNBIASED DATA
plt.figure(figsize=(14, 7))
plt.scatter(df['ra'], df['velocity'], c='lightsteelblue', alpha=0.1, s=1, label='Unbiased Population')
plt.plot(df['ra'], df['rolling_jitter'], color='navy', linewidth=2, label='Metric Jitter Scan')

# The Discovery Marker
plt.axvline(x=blind_ra, color='crimson', linestyle='--', linewidth=2, label=f'Discovered Nozzle: RA {blind_ra:.2f}')
plt.fill_between(df['ra'], baseline_val, df['rolling_jitter'], where=(df['rolling_jitter'] > baseline_val), color='red', alpha=0.2)

plt.title(f"Blind Discovery: {void_name}\nPeak Identified at RA {blind_ra:.2f} | Surge: {blind_surge:.2f}%", fontsize=15)
plt.xlabel("Right Ascension (RA)")
plt.ylabel("Kinematic Jitter (km/s)")
plt.legend()
plt.show()

print(f"\n--- BLIND DISCOVERY LOG ---")
print(f"Independent Peak RA: {blind_ra:.4f}")
print(f"Calculated Baseline: {baseline_val:.2f} km/s")
print(f"Peak Jitter Found: {peak_val:.2f} km/s")
print(f"Discovery Significance (Surge): {blind_surge:.2f}%")

import pandas as pd
import numpy as np
from astroquery.sdss import SDSS

# 1. PARAMETERS
void_name = "Boötes_Blind_Discovery_Table"
ra_min, ra_max = 205.0, 235.0  
dec_min, dec_max = 30.0, 50.0   

# 2. DATA ACQUISITION
query = f"""
SELECT p.ra, p.dec, s.z as redshift, s.zWarning as warning_flag
FROM PhotoObj AS p
JOIN SpecObj AS s ON s.bestobjid = p.objid
WHERE p.ra BETWEEN {ra_min} AND {ra_max} AND p.dec BETWEEN {dec_min} AND {dec_max}
AND s.class = 'GALAXY'
"""
print(f"Retrieving data for {void_name}...")
df = SDSS.query_sql(query).to_pandas()
df['velocity'] = df['redshift'] * 299792.458

# 3. BLIND PEAK DETECTION (Window = 100)
df = df.sort_values('ra')
df['rolling_jitter'] = df['velocity'].rolling(window=100).std()
peak_idx = df['rolling_jitter'].idxmax()
blind_ra = df.loc[peak_idx, 'ra']

# 4. ALIGN DATA TO DISCOVERED NOZZLE
# We create a relative axis where 0 is the Discovery Point
df['relative_ra'] = df['ra'] - blind_ra

# 5. GENERATE THE FORENSIC BIN TABLE
# We look 10 degrees on either side of the discovery
df_filtered = df[(df['relative_ra'] > -10) & (df['relative_ra'] < 10)].copy()
df_filtered['bin'] = pd.cut(df_filtered['relative_ra'], bins=12)

forensic_table = df_filtered.groupby('bin', observed=False).agg({
    'velocity': ['count', 'mean', 'std'],
    'warning_flag': 'sum'
}).reset_index()

forensic_table.columns = ['Relative_RA_Bin', 'Galaxy_Count', 'Mean_V', 'Jitter_Std', 'Total_Warnings']

# 6. RESULTS
print(f"\n--- BLIND DISCOVERY RESULTS ---")
print(f"Algorithmically Discovered Nozzle RA: {blind_ra:.4f}")
print(f"\n--- FORENSIC VALIDATION TABLE (Centered on Discovery) ---")
print(forensic_table)

# Calculate Discovery Surge
baseline = df['rolling_jitter'].median()
peak = peak_val = df['rolling_jitter'].max()
print(f"\nFinal Discovery Surge: {((peak/baseline)-1)*100:.2f}%")
