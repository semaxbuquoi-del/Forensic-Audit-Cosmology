import pandas as pd
from astroquery.vizier import Vizier
from astropy.coordinates import SkyCoord
import astropy.units as u

# --- AUDIT CONFIGURATION ---
# Define the Sculptor Void (Southern Hemisphere)
# Centered to capture the Sculptor Wall and Southern Wall barriers
void_config = {
    "name": "Sculptor_Void",
    "ra_range": [350.0, 15.0],  # Crosses 0h; logic handles wrap-around
    "dec_range": [-40.0, -20.0],
    "sink_anchor": "Abell 4038"
}

def retrieve_void_population(config):
    print(f"Starting Complete Audit: {config['name']}")
    
    # Configure Vizier for 6dFGS (Best for Sculptor/Southern Hemisphere)
    # Using VII/249/6dfgs for spectroscopic redshifts
    v = Vizier(columns=['*', 'z', 'r_mag', 'quality'])
    v.ROW_LIMIT = -1 

    # Calculate search center and width
    ra_center = 2.5 # Midpoint of 350 to 15
    dec_center = (config['dec_range'][0] + config['dec_range'][1]) / 2
    
    # Query the database
    # width=25deg, height=20deg to capture the barrier filaments
    try:
        results = v.query_region(
            SkyCoord(ra=ra_center, dec=dec_center, unit=(u.deg, u.deg)),
            width=25*u.deg, height=20*u.deg, 
            catalog="VII/249/6dfgs"
        )
        df = results[0].to_pandas()
        
        # Forensic Filter: Keep only high-confidence galaxies for the baseline
        # 6dFGS quality 3 or 4 are reliable spectroscopic redshifts
        df = df[df['quality'] >= 3]
        
        print(f"Total Sculptor Population Retrieved: {len(df)}")
        df.to_csv(f"{config['name']}_forensic_audit.csv", index=False)
        return df
    except Exception as e:
        print(f"Retrieval Failed: {e}")
        return None

# Execute Retrieval
sculptor_data = retrieve_void_population(void_config)

