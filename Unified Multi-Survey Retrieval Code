# 1. Setup Environment
!pip install -q astroquery
import pandas as pd
import numpy as np
from astroquery.sdss import SDSS

# --- CONFIGURATION ---
void_name = "Bootes_Void"
ra_min, ra_max = 211.0, 226.0
dec_min, dec_max = 38.0, 50.0
c = 299792.458 # Speed of light in km/s
m_p = 938.272e6 # Proton mass in eV/c^2 (for Ek calculation)

# 2. Forensic Retrieval Query
print(f"Retrieving data for {void_name} barriers...")
query = f"""
SELECT s.ra, s.dec, s.z, s.zwarning, s.plate, s.mjd, s.fiberid, p.r
FROM PhotoObj AS p JOIN SpecObj AS s ON s.bestobjid = p.objid
WHERE s.ra BETWEEN {ra_min} AND {ra_max} AND s.dec BETWEEN {dec_min} AND {dec_max}
AND s.class = 'GALAXY' AND s.snMedian > 5
"""
res = SDSS.query_sql(query)
df = res.to_pandas()
df['v_kms'] = df['z'] * c

# 3. Calculate Metric Jitter (0.5 degree bins)
df['ra_bin'] = (df['ra'] // 0.5) * 0.5
df['dec_bin'] = (df['dec'] // 0.5) * 0.5
jitter_map = df.groupby(['ra_bin', 'dec_bin'])['v_kms'].agg(['std', 'count']).reset_index()
jitter_map.columns = ['ra', 'dec', 'jitter_kms', 'count']
jitter_map = jitter_map[jitter_map['count'] >= 2] # Require at least 2 galaxies for dispersion

# 4. Isolate Bright Nulls (The "Metric Snap" candidates)
bright_nulls = df[(df['r'] < 18) & ((df['z'] < 0.001) | (df['zwarning'] != 0))].copy()

# 5. The Thermodynamic Bridge: Jitter-to-keV Conversion
peak_jitter = jitter_map['jitter_kms'].max()
# Ek = 0.5 * m_p * (v/c)^2
# Result converted to keV (divide by 1000)
ek_kev = (0.5 * m_p * (peak_jitter / c)**2) / 1000

# 6. Save all data to CSV
df.to_csv(f'{void_name}_raw_population.csv', index=False)
jitter_map.to_csv(f'{void_name}_jitter_analysis.csv', index=False)
bright_nulls.to_csv(f'{void_name}_bright_nulls.csv', index=False)

# 7. Forensic Summary
print("\n" + "="*30)
print(f"AUDIT SUMMARY: {void_name}")
print(f"Total Population: {len(df)}")
print(f"Bright Nulls Found: {len(bright_nulls)}")
print(f"Peak Metric Jitter: {peak_jitter:.2f} km/s")
print(f"Calculated Energy (Ek): {ek_kev:.2f} keV")
print("="*30)
print("Files generated: Raw Population, Jitter Analysis, Bright Nulls (CSV)")
