import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from astroquery.sdss import SDSS

# 1. DEFINE VOID SPATIAL ENVELOPE (The "Dead Zone" only)
ra_min, ra_max = 205.0, 235.0
dec_min, dec_max = 30.0, 50.0
z_min, z_max = 0.04, 0.06  # Isolating the interior of the Boötes Void

# 2. SQL QUERY WITH PHOTOMETRIC DEPTH
query = f"""
SELECT
    p.ra, p.dec, p.modelMag_r as r_mag, 
    s.z as redshift, s.zWarning as warning_flag,
    s.zErr as z_err
FROM PhotoObj AS p
JOIN SpecObj AS s ON s.bestobjid = p.objid
WHERE
    p.ra BETWEEN {ra_min} AND {ra_max}
    AND p.dec BETWEEN {dec_min} AND {dec_max}
    AND s.z BETWEEN {z_min} AND {z_max}
    AND s.class = 'GALAXY'
"""

print(f"Auditing Internal Void Population (z={z_min} to {z_max})...")
results = SDSS.query_sql(query)
df = results.to_pandas()

# 3. CALCULATE DISTANCE MODULUS (DM) & LUMINOSITY DISTANCE
# H0 = 70 km/s/Mpc (Standard)
H0 = 70.0 
c = 299792.458
df['dist_mpc'] = (df['redshift'] * c) / H0
# Distance Modulus formula: 5 * log10(d_pc) - 5 (using Mpc needs +25)
df['DM'] = 5 * np.log10(df['dist_mpc']) + 25

# 4. BLIND KINEMATIC SCAN
df = df.sort_values('ra')
# Since the population is smaller inside the void, we use a window of 10
df['rolling_jitter'] = (df['redshift'] * c).rolling(window=10).std()

peak_idx = df['rolling_jitter'].idxmax()
blind_ra = df.loc[peak_idx, 'ra']
peak_val = df['rolling_jitter'].max()
baseline_val = df['rolling_jitter'].median()

# 5. 3D VISUALIZATION: THE HOLLOW VOID
plt.figure(figsize=(14, 7))
sc = plt.scatter(df['ra'], df['DM'], c=df['rolling_jitter'], cmap='inferno', s=50)
plt.colorbar(sc, label='Velocity Jitter (km/s)')

plt.axvline(x=blind_ra, color='cyan', linestyle='--', label=f'Discovery: RA {blind_ra:.2f}')
plt.title("3D Interior Void Audit: Distance Modulus vs RA\n(Isolated Boötes Interior Population)", fontsize=14)
plt.xlabel("Right Ascension (RA)")
plt.ylabel("Distance Modulus (DM)")
plt.gca().invert_yaxis() # Convention: larger DM (further) is lower on plot
plt.legend()
plt.show()

print(f"\n--- INTERIOR VOID DISCOVERY LOG ---")
print(f"Galaxies found INSIDE Void: {len(df)}")
print(f"Detected Peak RA: {blind_ra:.4f}")
print(f"Peak Jitter: {peak_val:.2f} km/s")
print(f"Surge over Internal Baseline: {((peak_val/baseline_val)-1)*100:.2f}%")

import pandas as pd
import numpy as np
from astroquery.sdss import SDSS

# 1. RE-ESTABLISH DATA (Using your discovered 2,355 interior galaxies)
ra_min, ra_max = 205.0, 235.0
dec_min, dec_max = 30.0, 50.0
z_min, z_max = 0.04, 0.06 

query = f"""
SELECT p.ra, s.z as redshift, p.modelMag_r as r_mag
FROM PhotoObj AS p
JOIN SpecObj AS s ON s.bestobjid = p.objid
WHERE p.ra BETWEEN {ra_min} AND {ra_max} AND p.dec BETWEEN {dec_min} AND {dec_max}
AND s.z BETWEEN {z_min} AND {z_max} AND s.class = 'GALAXY'
"""
df = SDSS.query_sql(query).to_pandas()

# 2. CALCULATE PHYSICS METRICS
c = 299792.458
H0 = 70.0
df['velocity'] = df['redshift'] * c
df['dist_mpc'] = df['velocity'] / H0
df['DM'] = 5 * np.log10(df['dist_mpc']) + 25

# 3. ALIGN TO BLIND DISCOVERY POINT (RA 205.25)
blind_ra = 205.2561
df['relative_ra'] = df['ra'] - blind_ra

# 4. GENERATE 3D FORENSIC TABLE
# We bin by RA to show the surge centered at 0
df['bin'] = pd.cut(df['relative_ra'], bins=10)

forensic_3d = df.groupby('bin', observed=False).agg({
    'velocity': ['count', 'std'],
    'DM': 'mean',
    'r_mag': 'mean'
}).reset_index()

forensic_3d.columns = ['Relative_RA_Bin', 'Galaxy_Count', 'Jitter_Std', 'Avg_Distance_Modulus', 'Avg_Brightness']

print(f"--- 3D INTERIOR FORENSIC TABLE ---")
print(f"Centered on Discovered Nozzle: RA {blind_ra}")
print(forensic_3d)

# 5. CALCULATE THE "VACUUM TENSION" COEFFICIENT
baseline = forensic_3d['Jitter_Std'].median()
peak = forensic_3d['Jitter_Std'].max()
print(f"\nMetric Surge Significance: {((peak/baseline)-1)*100:.2f}%")
